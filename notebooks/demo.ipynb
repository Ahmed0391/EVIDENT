    "## 3 · Stage 2 — extraction vs. ground truth\n",
    "\n",
    "The extractor turns OCR text into typed fields. Because the dataset was generated\n",
    "data-first, we have **free ground truth** to check against (the pipeline never\n",
    "sees it — it's only for display here).\n",
    "\n",
    "*(This is the no-LLM regex baseline. Switch to the LLM with\n",
    "`extract_fields(ocr.text, doc.doc_type, backend=\"llm\")` once Ollama is running.)*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "0a279270",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-19T20:16:38.019774Z",
     "iopub.status.busy": "2026-09-19T20:16:38.019533Z",
     "iopub.status.idle": "2026-09-19T20:16:38.026609Z",
     "shell.execute_reply": "2026-09-19T20:16:38.025744Z"
    }
   },
   "outputs": [
    {
     "data": {
      "text/html": [
       "<table style='border-collapse:collapse;font-family:monospace'><tr><th style='text-align:left;padding:2px 10px'>field</th><th style='text-align:left;padding:2px 10px'>extracted</th><th style='text-align:left;padding:2px 10px'>ground truth</th><th style='padding:2px 10px'>match</th></tr><tr><td style='padding:2px 10px'>full_name</td><td style='padding:2px 10px'><b>Virginie Dias</b></td><td style='padding:2px 10px;color:#666'>Virginie Dias</td><td style='padding:2px 10px;color:#2E8B57'>✓</td></tr><tr><td style='padding:2px 10px'>id_number</td><td style='padding:2px 10px'><b>60129040</b></td><td style='padding:2px 10px;color:#666'>60129040</td><td style='padding:2px 10px;color:#2E8B57'>✓</td></tr><tr><td style='padding:2px 10px'>dob</td><td style='padding:2px 10px'><b>31/03/1986</b></td><td style='padding:2px 10px;color:#666'>31/03/1986</td><td style='padding:2px 10px;color:#2E8B57'>✓</td></tr><tr><td style='padding:2px 10px'>expiry</td><td style='padding:2px 10px'><b>01/06/2035</b></td><td style='padding:2px 10px;color:#666'>01/06/2035</td><td style='padding:2px 10px;color:#2E8B57'>✓</td></tr></table>"
      ],
      "text/plain": [
       "<IPython.core.display.HTML object>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def _norm(s):\n",
    "    s = unicodedata.normalize(\"NFKD\", str(s or \"\"))\n",
    "    s = \"\".join(c for c in s if not unicodedata.combining(c))\n",
    "    return \" \".join(s.lower().split())\n",
    "\n",
    "def kv_table(pred, gold, fields):\n",
    "    rows = \"\"\n",
    "    for f in fields:\n",
    "        p, g = pred.get(f, \"\"), gold.get(f, \"\")\n",
    "        ok = \"✓\" if g and _norm(p) == _norm(g) else (\"\" if not g else \"✗\")\n",
    "        color = \"#2E8B57\" if ok == \"✓\" else (\"#C0392B\" if ok == \"✗\" else \"#999\")\n",
    "        rows += (f\"<tr><td style='padding:2px 10px'>{f}</td>\"\n",
    "                 f\"<td style='padding:2px 10px'><b>{p or '—'}</b></td>\"\n",
    "                 f\"<td style='padding:2px 10px;color:#666'>{g or '—'}</td>\"\n",
    "                 f\"<td style='padding:2px 10px;color:{color}'>{ok}</td></tr>\")\n",
    "    return (\"<table style='border-collapse:collapse;font-family:monospace'>\"\n",
    "            \"<tr><th style='text-align:left;padding:2px 10px'>field</th>\"\n",
    "            \"<th style='text-align:left;padding:2px 10px'>extracted</th>\"\n",
    "            \"<th style='text-align:left;padding:2px 10px'>ground truth</th>\"\n",
    "            \"<th style='padding:2px 10px'>match</th></tr>\" + rows + \"</table>\")\n",
    "\n",
    "pred = extract_fields(ocr.text, doc.doc_type)\n",
    "display(HTML(kv_table(pred, doc.gold_fields, FIELDS_BY_TYPE[doc.doc_type])))"
   ]
  },
