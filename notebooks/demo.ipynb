    "%matplotlib inline\n",
    "import json, matplotlib.pyplot as plt\n",
    "\n",
    "rep = json.load(open(\"eval/results/confidence.json\"))\n",
    "print(f\"decision accuracy: {rep['decision_accuracy']:.3f}\")\n",
    "print(f\"ECE  raw = {rep['ece_raw']:.3f}   →   calibrated = {rep['ece_calibrated']:.3f}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5.2, 5.2))\n",
    "ax.plot([0, 1], [0, 1], ls=\"--\", lw=1, color=\"#8A96A3\", label=\"perfect\")\n",
    "for key, color, lab in [(\"reliability_raw\", \"#B8760A\", f\"raw (ECE {rep['ece_raw']:.2f})\"),\n",
    "                        (\"reliability_calibrated\", \"#0E7C7B\", f\"calibrated (ECE {rep['ece_calibrated']:.2f})\")]:\n",
    "    pts = rep[key]\n",
    "    if pts:\n",
    "        ax.plot([p[0] for p in pts], [p[1] for p in pts], \"-o\", color=color, lw=2, ms=5, label=lab)\n",
    "ax.set_xlim(0, 1); ax.set_ylim(0, 1)\n",
    "ax.set_xlabel(\"predicted confidence\"); ax.set_ylabel(\"observed accuracy\")\n",
    "ax.set_title(\"Reliability diagram\")\n",
    "for s in (\"top\", \"right\"):\n",
    "    ax.spines[s].set_visible(False)\n",
    "ax.legend(frameon=False, fontsize=9, loc=\"upper left\")\n",
    "plt.tight_layout(); plt.show()"
   ]
